{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "definitions": {
    "CompoundResetOutcome": {
      "enum": [
        "completed",
        "failed",
        "canceled",
        "uncertain"
      ],
      "type": "string"
    },
    "CompoundWaitTicket": {
      "additionalProperties": false,
      "properties": {
        "generation": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "waitId": {
          "type": "string"
        }
      },
      "required": [
        "generation",
        "waitId"
      ],
      "type": "object"
    }
  },
  "properties": {
    "cellId": {
      "type": "string"
    },
    "diagnostic": {
      "type": [
        "string",
        "null"
      ]
    },
    "itemId": {
      "type": "string"
    },
    "reset": {
      "$ref": "#/definitions/CompoundResetOutcome"
    },
    "threadId": {
      "type": "string"
    },
    "ticket": {
      "anyOf": [
        {
          "$ref": "#/definitions/CompoundWaitTicket"
        },
        {
          "type": "null"
        }
      ]
    },
    "turnId": {
      "type": "string"
    },
    "windowId": {
      "type": "string"
    }
  },
  "required": [
    "cellId",
    "itemId",
    "reset",
    "threadId",
    "turnId",
    "windowId"
  ],
  "title": "CompoundWaitReset",
  "type": "object"
}