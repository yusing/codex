{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "AgentMetrics": {
      "properties": {
        "completedCompactions": {
          "format": "uint64",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "contextTokens": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "contextWindow": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "AgentObservation": {
      "properties": {
        "attachable": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "backend": {
          "type": [
            "string",
            "null"
          ]
        },
        "cwd": {
          "type": [
            "string",
            "null"
          ]
        },
        "loaded": {
          "type": "boolean"
        },
        "metrics": {
          "$ref": "#/definitions/AgentMetrics"
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "nickname": {
          "type": [
            "string",
            "null"
          ]
        },
        "parentThreadId": {
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "type": [
            "string",
            "null"
          ]
        },
        "reasoningEffort": {
          "anyOf": [
            {
              "$ref": "#/definitions/ReasoningEffort"
            },
            {
              "type": "null"
            }
          ]
        },
        "role": {
          "type": [
            "string",
            "null"
          ]
        },
        "rootThreadId": {
          "type": "string"
        },
        "serviceTier": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "anyOf": [
            {
              "$ref": "#/definitions/AgentRuntimeStatus"
            },
            {
              "type": "null"
            }
          ]
        },
        "threadId": {
          "type": "string"
        },
        "wait": {
          "anyOf": [
            {
              "$ref": "#/definitions/AgentWaitObservation"
            },
            {
              "type": "null"
            }
          ]
        },
        "work": {
          "anyOf": [
            {
              "$ref": "#/definitions/AgentWorkObservation"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "loaded",
        "metrics",
        "rootThreadId",
        "threadId"
      ],
      "type": "object"
    },
    "AgentRuntimeStatus": {
      "enum": [
        "pending_init",
        "running",
        "interrupted",
        "completed",
        "errored",
        "shutdown",
        "not_found"
      ],
      "type": "string"
    },
    "AgentWaitMode": {
      "enum": [
        "any",
        "all"
      ],
      "type": "string"
    },
    "AgentWaitObservation": {
      "properties": {
        "deadlineUnixMs": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "mode": {
          "$ref": "#/definitions/AgentWaitMode"
        },
        "phase": {
          "$ref": "#/definitions/AgentWaitPhase"
        },
        "reason": {
          "anyOf": [
            {
              "$ref": "#/definitions/CoordinationTurnWaitReason"
            },
            {
              "type": "null"
            }
          ]
        },
        "selected": {
          "items": {
            "$ref": "#/definitions/AgentWaitTarget"
          },
          "type": "array"
        },
        "timeoutMs": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "waitId": {
          "type": "string"
        }
      },
      "required": [
        "mode",
        "phase",
        "selected",
        "waitId"
      ],
      "type": "object"
    },
    "AgentWaitPhase": {
      "enum": [
        "registered",
        "claimed",
        "dispatched",
        "accepted",
        "consumed",
        "cancelled"
      ],
      "type": "string"
    },
    "AgentWaitTarget": {
      "properties": {
        "threadId": {
          "type": "string"
        },
        "workId": {
          "type": "string"
        }
      },
      "required": [
        "threadId",
        "workId"
      ],
      "type": "object"
    },
    "AgentWorkDisposition": {
      "enum": [
        "pending_start",
        "running",
        "waiting",
        "paused",
        "uncertain",
        "completed",
        "failed",
        "interrupted"
      ],
      "type": "string"
    },
    "AgentWorkObservation": {
      "properties": {
        "disposition": {
          "$ref": "#/definitions/AgentWorkDisposition"
        },
        "revision": {
          "format": "int64",
          "type": "integer"
        },
        "terminalDeliveryId": {
          "type": [
            "string",
            "null"
          ]
        },
        "workId": {
          "type": "string"
        }
      },
      "required": [
        "disposition",
        "revision",
        "workId"
      ],
      "type": "object"
    },
    "CoordinationTurnWaitReason": {
      "enum": [
        "descendantRecovery",
        "providerCapacity",
        "providerUsageLimit"
      ],
      "type": "string"
    },
    "ReasoningEffort": {
      "description": "A non-empty reasoning effort value advertised by the model.",
      "minLength": 1,
      "type": "string"
    }
  },
  "properties": {
    "agent": {
      "$ref": "#/definitions/AgentObservation"
    }
  },
  "required": [
    "agent"
  ],
  "title": "AgentObserveResponse",
  "type": "object"
}