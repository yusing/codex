{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "definitions": {
    "CompoundWaitAction": {
      "enum": [
        "retain",
        "retire",
        "superseded",
        "commit",
        "uncertain"
      ],
      "type": "string"
    },
    "CompoundWaitTicket": {
      "additionalProperties": false,
      "properties": {
        "generation": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "waitId": {
          "type": "string"
        }
      },
      "required": [
        "generation",
        "waitId"
      ],
      "type": "object"
    },
    "ReloadSelection": {
      "additionalProperties": false,
      "description": "Sources reacquired before the first inference in a replacement context window.",
      "properties": {
        "sources": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "sources"
      ],
      "type": "object"
    }
  },
  "properties": {
    "action": {
      "$ref": "#/definitions/CompoundWaitAction"
    },
    "diagnostic": {
      "type": [
        "string",
        "null"
      ]
    },
    "reload": {
      "anyOf": [
        {
          "$ref": "#/definitions/ReloadSelection"
        },
        {
          "type": "null"
        }
      ]
    },
    "ticket": {
      "$ref": "#/definitions/CompoundWaitTicket"
    }
  },
  "required": [
    "action",
    "ticket"
  ],
  "title": "CompoundWaitDisposition",
  "type": "object"
}